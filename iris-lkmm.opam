opam-version: "2.0"
name: "iris-lkmm"
version: "dev"
synopsis: "Rocq/Iris foundations for an LKMM concurrency model"
maintainer: "iris-lkmm contributors"
authors: "iris-lkmm contributors"
license: "BSD-3-Clause"
homepage: "https://github.com/joehattori/iris-lkmm"
bug-reports: "https://github.com/joehattori/iris-lkmm/issues"
dev-repo: "git+https://github.com/joehattori/iris-lkmm.git"

depends: [
  "dune" {>= "3.8" & build}
  "rocq-core" {>= "9.0" & < "9.2"}
  "rocq-stdlib"
  "rocq-stdpp" {= "1.13.0"}
  "rocq-iris" {= "4.5.0"}
]

build: [make "all"]

